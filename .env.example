# ==================================================
# DriveFlow Environment Variables
# ==================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# --------------------------------------------------
# Supabase
# --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — server-side only, NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --------------------------------------------------
# Platform Configuration
# --------------------------------------------------
NEXT_PUBLIC_PLATFORM_DOMAIN=driveflow.com.au
NEXT_PUBLIC_PLATFORM_NAME=DriveFlow
NEXT_PUBLIC_PLATFORM_ADMIN_SUBDOMAIN=admin

# --------------------------------------------------
# Application
# --------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --------------------------------------------------
# Development Only
# --------------------------------------------------
# Required for localhost development — set to the slug of the
# organization you want to develop against. Without this,
# localhost tenant resolution will fail.
DEV_TENANT_SLUG=sydney-driving-academy

# --------------------------------------------------
# Stripe (required for payments in production)
# --------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --------------------------------------------------
# Email (optional — falls back to log provider)
# --------------------------------------------------
# RESEND_API_KEY=re_...

# --------------------------------------------------
# Monitoring (optional)
# --------------------------------------------------
# SENTRY_DSN=https://...@sentry.io/...

# --------------------------------------------------
# Vercel (set automatically by Vercel)
# --------------------------------------------------
# VERCEL_URL — auto-set by Vercel
# VERCEL_GIT_COMMIT_SHA — auto-set by Vercel
